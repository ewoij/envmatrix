{
  "name": "envmatrix",
  "version": "0.1.0",
  "description": "Compare and edit multiple .env files in a browser-based matrix view.",
  "keywords": [
    "dotenv",
    "env",
    "diff",
    "compare",
    "matrix",
    "cli"
  ],
  "license": "MIT",
  "author": "Jonas Berdoz",
  "repository": {
    "type": "git",
    "url": "https://github.com/ewoij/envmatrix.git"
  },
  "type": "module",
  "bin": {
    "envmatrix": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "tsc -p tsconfig.json --noEmit && node --test --import tsx test/parse.test.ts test/matrix.test.ts test/color.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
